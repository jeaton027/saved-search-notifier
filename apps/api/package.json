{
	"name": "@saved-search/api",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc -p tsconfig.json",
		"start": "node dist/index.js",
		"prisma:generate": "prisma generate",
		"prisma:migrate": "prisma migrate dev --name init",
		"prisma:deploy": "prisma migrate deploy",
		"seed:demo": "tsx src/scripts/seed-demo.ts",
		"test": "vitest run",
		"lint": "echo 'no-op lint for api'",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@fastify/cors": "^10.1.0",
		"@fastify/jwt": "^9.0.1",
		"@fastify/rate-limit": "^10.1.0",
		"@fastify/sensible": "^6.0.2",
		"@fastify/swagger": "^9.3.1",
		"@fastify/swagger-ui": "^5.2.2",
		"@prisma/client": "^5.22.0",
		"@saved-search/shared": "workspace:*",
		"bcryptjs": "^2.4.3",
		"bullmq": "^5.16.0",
		"fastify": "^5.0.0",
		"fastify-plugin": "^5.0.1",
		"ioredis": "^5.4.1",
		"rss-parser": "^3.13.0",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@types/bcryptjs": "^2.4.6",
		"@types/node": "^22.5.5",
		"prisma": "^5.22.0",
		"tsx": "^4.19.1",
		"typescript": "^5.6.2",
		"vitest": "^2.1.1"
	}
}
